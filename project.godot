; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Night Coop"
run/main_scene="res://scenes/arcade/game.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
throw_feed={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
pause_round={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305)]
}

[internationalization]

locale/fallback="zh_CN"
locale/translations=PackedStringArray("res://assets/i18n/en.po")

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Cover"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
